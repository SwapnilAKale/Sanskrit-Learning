{
  "about": "Claude Code. Follows the default conventions.",
  "agent": "claude-code",
  "ignore": [
    "PermissionRequest",
    "Notification",
    "PostToolUse",
    "PostToolUseFailure",
    "StopFailure"
  ],
  "install": {
    "plugin": {
      "marketplace": "sanskrit_learning-local",
      "name": "sanskrit_learning",
      "path": "src/adapters/claude-code"
    }
  },
  "skipIf": [
    "cursor_version"
  ]
}
